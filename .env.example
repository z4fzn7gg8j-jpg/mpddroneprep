# Copy this file to .env (frontend) and configure the matching values in
# Netlify's site environment variables (functions + build). Every value
# below is a placeholder -- nothing here is a working credential.

# --- Frontend (Vite) ---
# Leave both unset to run in local demo mode (localStorage only, no
# accounts, no email -- see src/lib/storage.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Netlify Functions (server-side only -- never prefix with VITE_) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list is NOT read automatically by this schema; domains
# are stored one-per-row in the allowed_email_domains table (see
# supabase/schema.sql). Set this only as a reference for your own setup
# scripts if you write one -- do not assume the app reads it directly.
# Example: maricopa-az.gov
ALLOWED_EMAIL_DOMAINS_REFERENCE_ONLY=

RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
# Coordinator summary emails always go here -- never to an address chosen
# by the browser (spec section 8).
COORDINATOR_EMAIL=
# While set, send-queued-emails.ts refuses to send to any address outside
# this domain. Keep this set until you are deliberately ready to send to
# real officer inboxes (spec section 8: "do not send actual officer
# emails during development").
EMAIL_SANDBOX_DOMAIN=

# Base URL the app is deployed at, used to build links inside emails.
PUBLIC_APP_URL=

# Optional: Cloudflare Turnstile site/secret keys, if you wire up
# abuse protection on sign-in (spec section 11 lists Turnstile as
# preferred; not implemented in this delivery -- see KNOWN_LIMITATIONS.md).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
